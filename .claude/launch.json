{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && yarn dev --port 3000"
      ],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && ./venv/bin/python -m uvicorn server:app --port 8001"
      ],
      "port": 8001
    }
  ]
}
