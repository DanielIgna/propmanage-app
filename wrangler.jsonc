{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "propmanage-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BACKEND_URL": "https://backend-production-e5b7d.up.railway.app"
  },
  "assets": {
    "directory": "./cf-site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/api", "/api/*", "/uploads", "/uploads/*"]
  }
}
